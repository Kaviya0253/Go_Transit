# Copy this file to .env and fill it in. Never commit the real .env.

# Google Maps key (restrict it to your website's address in Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=

# Where the backend runs. Leave empty locally (uses http://localhost:5000).
# After deploying the backend, set it to its address, e.g. https://go-transit-api.onrender.com
VITE_API_URL=
